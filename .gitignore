# Copy this file to the Git repository and rename it ".gitignore".
# Lines starting with '#' are treated as comments.

############################################
## USER SCRIPTS AND NOTES
############################################

/*.bat
/\!*
.DS_Store
*.pdf
# Keep the current resume and its deliverable export under version control.
!/resume.pdf
!/output/pdf/resume-agent.pdf

# Keep output limited to the current resume deliverable.
/output/*
!/output/pdf/
/output/pdf/*
!/output/pdf/resume-agent.pdf

# Local runtime dependencies, including symlinks into the Codex runtime.
node_modules
__pycache__/
*.pyc

############################################
## LATEX TEMPORARY FILES
############################################

*.log
*.aux
*.bbl
*.blg
*.tex.undo
*.tex.bak
*.~te
*.$te
*.DVX
*.DDF
*.synctex.gz
*.synctex.gz(busy)
*.fdb_latexmk
*.fls
*.out
*.toc
*.lof
*.lot
*.idx
*.ilg
*.ind

*.dvi
*.ps

############################################
# do not upload secret infomation
myresume.tex
myresume.pdf
